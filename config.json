{
  "fit":{
    "hidden_channels": 16,
    "kernel_size": 3,
    "units": 8,
    "activation": "relu",
    "device": "cuda",
    "lr": 0.0015,
    "weight_decay": 0.01,
    "split_seq_len": 10,
    "epochs": 2,
    "save_best": true,
    "model_path": "saves/weights",
    "csv_log": {
      "output_dir": "saves/training_logs"
    },
    "train":{
      "batch_size": 16,
      "data_augmentation": true,
      "n_workers": 4
    },
    "valid": {
      "batch_size": 32,
      "n_workers": 0
    },
    "test": {
      "batch_size": 32,
      "n_workers": 0
    }
  },
  "eval":{
    "model_path": "saves/rcnn_best",
    "batch_size": 32,
    "n_workers": 0,
    "hidden_channels": 16,
    "kernel_size": 3,
    "units": 8,
    "activation": "relu",
    "split_seq_len": 10,
    "device": "cuda"
  },
  "logger": {
    "level": "INFO",
    "log_to_file": true,
    "log_file": "logs/rcnn.log",
    "max_bytes": 5242880,
    "backup_count": 3
  }
}
